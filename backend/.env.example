# Copy to backend/.env and fill in.
OPENROUTER_API_KEY=sk-or-...
# Pick a tool-calling model at https://openrouter.ai/models (filter: Tools).
# Free variants end in ":free" and are rate limited; fine for development.
LLM_MODEL=CHANGE_ME/your-model-id

# SQLite (zero setup) by default. For Postgres, run `docker compose up -d db` and use:
# DATABASE_URL=postgresql+psycopg://consensus:consensus@localhost:5432/consensus
DATABASE_URL=sqlite:///./consensus.db

FRONTEND_ORIGIN=http://localhost:5173
